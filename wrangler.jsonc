{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-portal",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run the Worker near the database instead of near the visitor: every
  // request makes several DB round trips, so locality to Postgres wins.
  "placement": { "mode": "smart" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8231328d194b467ba4dc00dc4a6c23f5",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/trade_portal"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] }
}
