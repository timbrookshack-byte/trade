{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-portal",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Portal's own Postgres via Hyperdrive. NEVER point this at Shack360's DB —
  // 360 integration is API-only (see CLAUDE.md golden rules).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the real Hyperdrive config id before first deploy:
      //   wrangler hyperdrive create trade-portal-db --connection-string="postgresql://..."
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/trade_portal"
    }
  ]
  // Milestone 2 will add: "triggers": { "crons": ["*/30 * * * *"] } for the 360 stock sync.
}
